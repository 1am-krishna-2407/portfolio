# Copy this file to .env.local and fill in the values. .env.local is ignored by git.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# ─── Portfolio assistant (Google Gemini) ─────────────────────────────────────
# Key from https://aistudio.google.com/apikey — server-side only, never exposed to the browser.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional: model used when the primary is overloaded (default: gemini-3.6-flash)
GEMINI_BACKUP_MODEL=
# Optional: alternative API base URL (e.g. a proxy); defaults to Google's endpoint
GEMINI_API_BASE=

# ─── Embeddings (Hugging Face, Qwen3-Embedding) — reserved, not used yet ─────
# The assistant reads the whole portfolio in one prompt, so it doesn't need
# embeddings today. These are here in case retrieval is added later.
HF_API_KEY=
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ─── GitHub (optional) ───────────────────────────────────────────────────────
# Raises the GitHub API rate limit for the pinned-repositories panel.
GITHUB_TOKEN=

# ─── Contact form (EmailJS) ──────────────────────────────────────────────────
# From https://dashboard.emailjs.com — Email Services (service ID), Email
# Templates (template ID), Account → General (public key). These are public by
# design; the NEXT_PUBLIC_EMAILJS_* names also work.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
